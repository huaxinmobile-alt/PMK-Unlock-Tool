# Visual Studio / build temp
.vs/
obj/
*.csproj.user
*.user

# ZCode session data (this folder is inside the project root)
.zcode/

# Local logs/scratch
*.log

# Build outputs (Loaders/edl/mtkclient တွေ source က copy ဖြစ်နေလို့ repo မှာ မထားတော့ဘူး)
WinFormsApp1/bin/

# Portable publish output (self-contained build) — folder ကြီးလို့ repo ထဲ မထည့်ဘူး
Publish/
publish/

# Release publish intermediate (dotnet publish build tree) — folder ကြီးလို့ exclude
WinFormsApp1/bin/Release/

# Release zip (local only — upload က GitHub Releases ကနေ)
Releases/

# Login user database (local per-PC — repo/zip ထဲ မထည့်)
users.dat*

# License private key (PMK ရဲ့ PC မှာပဲ — repo ထဲ ဘယ်တော့မှ မထည့်နဲ့)
tools/private/

# Login session (per-PC runtime — logout လုပ်ရင် ဖျက်တယ်)
session.dat
