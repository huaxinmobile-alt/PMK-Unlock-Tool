<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>4.0.8</Version>
		<Product>PMK Unlock Tool</Product>
		<AssemblyTitle>PMK Unlock Tool</AssemblyTitle>
		<Description>All-in-one Android flashing &amp; repair tool - Qualcomm EDL, MediaTek, Samsung, Spreadtrum, ADB, Fastboot</Description>
		<Company>PMK</Company>
		<Authors>PMK</Authors>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="System.IO.Ports" Version="10.0.11" />
	</ItemGroup>

	<!-- Loaders / edl / mtkclient ကို build ပြီးတိုင်း output folder ထဲ အလိုအလျောက် sync လုပ်ပေးခြင်း
	     (အသစ် clone လုပ်ပြီး build ရင် runtime folder တွေ bin ထဲ ကိုယ်တိုင်ရောက်လာမယ်) -->
	<ItemGroup>
		<Content Include="Loaders\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="edl\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="mtkclient\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- adb.exe ဲ့ fastboot.exe ကို Output folder ထဲ အလိုအလျောက် Copy ပေးမယ် -->
	<ItemGroup>
		<None Update="adb.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="fastboot.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="AdbWinApi.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="AdbWinUsbApi.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="mi.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
